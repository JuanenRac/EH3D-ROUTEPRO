    {
      "id": "op",
      "column": 0,
      "level": "external",
      "title": "The operator",
      "lines": [
        "keyboard and mouse, in a window",
        "or in a terminal (SSH, a text",
        "console, an old PC)"
      ]
    },
    {
      "id": "files",
      "column": 0,
      "level": "external",
      "title": "Plot files",
      "lines": [
        "HP-GL .PLT, the tool table",
        "ROUTEPRO.RTD and the machine",
